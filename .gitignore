# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — match `node_modules` anywhere in the tree (the leading-slash
# form below only matched the root, so `shared/node_modules`, `mobile/node_modules`,
# and any future workspace's node_modules were leaking through to git.)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Expo / Metro / pnpm
.expo/
.metro-health-check*
*.tsbuildinfo

/Mobile UI

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates
